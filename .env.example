# Copy to .env and fill in your values:
#   cp .env.example .env

# Required — OpenRouter API key (OpenAI-compatible)
OPENAI_API_KEY=
OPENAI_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=DocFlow-RAG

# Models
EMBEDDING_MODEL=text-embedding-3-small
QA_MODEL=gpt-3.5-turbo
AGENT_MODEL=gpt-3.5-turbo

# Paths
DATA_PATH=data/
DB_PATH=db/

# Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Retrieval
RETRIEVER_K=5
RETRIEVER_FETCH_K=20
SOURCE_LIMIT=2

# Timeouts (seconds)
LLM_TIMEOUT_SECONDS=45
AGENT_TIMEOUT_SECONDS=60
QUERY_TIMEOUT_SECONDS=90
EXTERNAL_RISK_TIMEOUT_SECONDS=4

# Query cache
QUERY_CACHE_ENABLED=true
QUERY_CACHE_MAX_SIZE=64

# Uploads and browser access
MAX_UPLOAD_SIZE_MB=25
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Optional external risk APIs (leave blank to skip)
# WEATHER_API_URL=
# NEWS_API_URL=
# SHIPPING_API_URL=

# API security (leave API_KEY blank to disable auth in local dev)
API_KEY=
RATE_LIMIT_PER_MINUTE=60
MAX_QUESTION_LENGTH=2000

# Hybrid retrieval (optional; requires rank-bm25 + sentence-transformers)
HYBRID_RETRIEVAL_ENABLED=false
RERANK_ENABLED=false
BM25_FETCH_K=20
RERANK_TOP_N=8

# LangSmith observability (optional)
LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=docflow-rag

# Knowledge graph (optional Neo4j)
GRAPH_EXTRACTION_ENABLED=false
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=

# Distributed ingestion (optional Celery + Redis)
CELERY_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO
